     delta1: "Delta", 0;
end_input
var
   c0 := 1;
   c1 := 0;
   b0 := 1;
   b1 := 0;
   b2 := 0;
   a1 := 0;
   a2 := 0;
   alpha := 0;
   beta1 := 0;
   gamma1 := 0;
end_var