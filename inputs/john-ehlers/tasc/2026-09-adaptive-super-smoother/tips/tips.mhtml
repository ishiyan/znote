 <h3 class=3D"newsTitle grey_blue" style=3D"text-transform: uppercase;">Pyt=
hon: September 2026</h3></div>
 <p>In his article in this issue, =E2=80=9CAdaptive SuperSmoother,=E2=80=9D=
 John Ehlers introduces his adaptive SuperSmoother indicator based on his o=
riginal SuperSmoother indicator. Presented here is Python code to construct=
 and display the indicator.</p>
<pre>"""
Python code to implement concepts in Technical Analysis of Stocks &amp; Com=
modiities magazine=20
article "Adaptive SuperSmoother" by John F Ehlers. This python code is prov=
ided for the=20
TraderTips section of the magazine.

Written By:
Rajeev Jain, July 2026
jainraje@yahoo,com

All code available in GitHub:
https://github.com/jainraje/TraderTipArticles/

"""


# import required python modules
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import yfinance as yf
import math

print(yf.__version__)


# retrive OHLCV using YFinance
symbol =3D 'QQQ'
ohlcv =3D yf.download(
    symbol,=20
    start=3D"2000-01-01",=20
    end=3D"2026-07-11",=20
    group_by=3D"Ticker",
    auto_adjust=3DFalse,
)
ohlcv =3D ohlcv[symbol]
ohlcv

# functions to implement indicators calculations=20

def rms(series, length):
    series =3D np.asarray(series, dtype=3Dfloat)
    out =3D np.full(len(series), np.nan)

    for i in range(length - 1, len(series)):
        window =3D series[i - length + 1:i + 1]
        out[i] =3D np.sqrt(np.mean(window ** 2))

    return out

def supersmoother(price, period):
    price =3D np.asarray(price, dtype=3Dfloat)
    out =3D np.full(len(price), np.nan)

    if len(price) &lt; 3:
        return price.copy()

    Q =3D np.exp(-1.414 * np.pi / period)
    c1 =3D 2 * Q * np.cos(1.414 * np.pi / period)
    c2 =3D Q * Q
    a0 =3D (1 - c1 + c2) / 2

    # initialization
    out[0] =3D price[0]
    out[1] =3D price[1]

    for i in range(2, len(price)):
        out[i] =3D (
            a0 * (price[i] + price[i - 1])
            + c1 * out[i - 1]
            - c2 * out[i - 2]
        )

    return out

def adaptive_supersmoother(close, period0=3D20, rms_length=3D81):
    close =3D np.asarray(close, dtype=3Dfloat)
    n =3D len(close)

    # outputs
    ss_adaptive =3D np.full(n, np.nan)
    ss_fixed =3D np.full(n, np.nan)
    period_series =3D np.full(n, np.nan)

    # initial pass (we update recursively)
    ss_temp =3D supersmoother(close, period0)

    roc1 =3D np.full(n, np.nan)
    roc =3D np.full(n, np.nan)

    for i in range(1, n):
        roc1[i] =3D ss_temp[i] - ss_temp[i - 1]

        # RMS normalization
        start =3D max(0, i - rms_length + 1)
        window =3D roc1[start:i + 1]
        rocrms =3D np.sqrt(np.mean(window ** 2)) if len(window) &gt; 0 else=
 0

        if rocrms !=3D 0:
            roc[i] =3D abs(roc1[i] / rocrms)
        else:
            roc[i] =3D 0

        roc[i] =3D min(roc[i], 2)

        period =3D period0 * (1 - 0.5 * roc[i]) ** 2
        period =3D max(period, 2)
        period_series[i] =3D period

    # Recompute adaptive SS properly (true recursive adaptive filter)
    ss_adaptive[0] =3D close[0]
    ss_adaptive[1] =3D close[1]

    for i in range(2, n):
        p =3D period_series[i - 1] if not np.isnan(period_series[i - 1]) el=
se period0

        Q =3D np.exp(-1.414 * np.pi / p)
        c1 =3D 2 * Q * np.cos(1.414 * np.pi / p)
        c2 =3D Q * Q
        a0 =3D (1 - c1 + c2) / 2

        ss_adaptive[i] =3D (
            a0 * (close[i] + close[i - 1])
            + c1 * ss_adaptive[i - 1]
            - c2 * ss_adaptive[i - 2]
        )

    return {
        "adaptive_ss": ss_adaptive,
        "fixed_ss": supersmoother(close, period0),
        "roc": roc,
        "period": period_series
    }

def adaptive_supersmoother_series(close, period0=3D20, rms_length=3D81):
    return pd.Series(
        adaptive_supersmoother(close, period0, rms_length)["adaptive_ss"],
        index=3Dclose.index
    )


# function which encapsultes indicator call and signal generationr=20
def run_calcs(ohlcv):
   =20
    df =3D ohlcv[['Close']].copy()

    df['SS'] =3D supersmoother(df['Close'], period=3D20)
    df['ASS'] =3D adaptive_supersmoother_series(df['Close'])

   =20
    df['ASS OSC'] =3D df['ASS'] - df['SS']
    df['ASS OSC NORM'] =3D (df['ASS'] - df['SS']) / df['Close'].rolling(20)=
.std()
   =20
    #df['Signal'] =3D np.where(df['ASS OSC'] &gt; 0, 1,0)
    df['Signal'] =3D np.where(df['ASS OSC'] &gt; 0.1, 1,
                    np.where(df['ASS OSC'] &lt; -0.1, 0, np.nan))
    df['Signal'] =3D df['Signal'].ffill()

    return df

df =3D run_calcs(ohlcv)
df
def simple_plot(df):
    import matplotlib.pyplot as plt

    fig, (ax1, ax2) =3D plt.subplots(
        2, 1,
        figsize=3D(9, 6),
        sharex=3DTrue,
        gridspec_kw=3D{"height_ratios": [3, 1]}
    )

    # -------------------
    # TOP: Price + filters + signal
    # -------------------
    ax1.plot(df.index, df['Close'], label=3D'Close', color=3D'black', linew=
idth=3D1.5)
    ax1.plot(df.index, df['SS'], label=3D'SuperSmoother (SS)', linewidth=3D=
1.2)
    ax1.plot(df.index, df['ASS'], label=3D'Adaptive SS (ASS)', linewidth=3D=
1.2)

    ax1.set_ylabel('Price')
    ax1.grid(True)

    # Signal on secondary axis (TOP)
    ax1b =3D ax1.twinx()
    ax1b.step(df.index, df['Signal'], where=3D'post',
              label=3D'Signal (ASS OSC &gt; 0)', color=3D'green', alpha=3D0=
.5)

    ax1b.set_ylabel('Signal (0/1)')
    ax1b.set_ylim(-0.1, 1.1)

    # combine legends (top)
    l1, lab1 =3D ax1.get_legend_handles_labels()
    l2, lab2 =3D ax1b.get_legend_handles_labels()
    ax1.legend(l1 + l2, lab1 + lab2, loc=3D'upper left')

    ax1.set_title('Price + SuperSmoother + Adaptive SS with Signal')

    # -------------------
    # BOTTOM: Oscillator
    # -------------------
    ax2.plot(df.index, df['ASS OSC'], label=3D'ASS - SS Oscillator', color=
=3D'purple', alpha=3D0.8)
    ax2.plot(df.index, df['ASS OSC NORM'], label=3D'ASS NORM- SS Oscillator=
', color=3D'orange', alpha=3D0.8)
   =20
    ax2.axhline(0, color=3D'black', linewidth=3D1)

    ax2.set_ylabel('Osc')
    ax2.set_xlabel('Date')
    ax2.grid(True)
    ax2.legend()

    plt.tight_layout()
    plt.show()
simple_plot(df['2026':])
</pre>
