<pre>using WealthLab.TASC;
using WealthLab.Backtest;
using WealthLab.Core;
using WealthLab.Indicators;

namespace WealthScript5
{
    public class SSAdaptiveDemo : UserStrategyBase
    {
        public SSAdaptiveDemo()
        {
            period =3D AddParameter("Period", ParameterType.Int32, 20, 4, 4=
0, 2);
        }

        public override void Initialize(BarHistory bars)
        {
            ssa =3D new SuperSmootherAdaptive(bars.Close, period.AsInt);
            PlotIndicator(ssa, WLColor.Blue, PlotStyle.Line);
            ss =3D new SuperSmoother(bars.Close, period.AsInt);
            PlotIndicator(ss, WLColor.Red, PlotStyle.Line);

            osc =3D ssa - ss;
            PlotTimeSeriesHistogramTwoColor(osc, $"Osc({Parameters[0].AsInt=
})", "SSOsc");
        }

        public override void Execute(BarHistory bars, int idx)
        {
            if (!HasOpenPosition(bars, PositionType.Long))
            {
                if (osc[idx] &gt; 0)
                    PlaceTrade(bars, TransactionType.Buy, OrderType.Market)=
;
            }
            else
            {
                if (osc[idx] &lt; 0)
                    ClosePosition(LastPosition, OrderType.Market);
            }
        }

        Parameter period;
        IndicatorBase ssa;
        IndicatorBase ss;
        TimeSeries osc;
    }
}

</pre>
